# Thin Triton-client image — no CUDA, no torch, no custom ffmpeg/OpenCV builds.
# Inference runs on the shared Triton server (see docker-compose.yml); this
# container only decodes video, tracks, counts, and publishes results.
# Legacy CUDA image preserved at legacy/dockerfile_legacy.
FROM python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1

# libglib/libgl: opencv-python-headless runtime deps; ffmpeg libs are bundled in the wheel
RUN apt-get update && apt-get install -y --no-install-recommends \
        libglib2.0-0 libgl1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install -r requirements.txt

COPY main.py counting.py counting_config.py app_state.py lifecycle.py ./
COPY inference/ ./inference/
COPY tracking/ ./tracking/
COPY outputs/ ./outputs/

EXPOSE 8090
CMD ["python", "main.py"]
